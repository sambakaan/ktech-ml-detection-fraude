# Copiez ce fichier en `.streamlit/secrets.toml` (déjà exclu de git/Docker) puis personnalisez-le.
#
# Pour générer le hash bcrypt d'un nouveau mot de passe :
#   python -c "import streamlit_authenticator as stauth; print(stauth.Hasher.hash('votre_mot_de_passe'))"

[cookie]
name = "fraud_app_auth"
# Chaîne aléatoire longue, propre à cette installation — à changer avant toute mise en production.
key = "change-moi-en-production-chaine-aleatoire-longue"
expiry_days = 1

# Un identifiant par défaut est fourni pour tester l'application (identifiant "admin",
# mot de passe "changeme123") — à remplacer avant toute mise en production réelle.
[credentials.usernames.admin]
email = "admin@ktech.local"
first_name = "Admin"
last_name = "KTech"
password = "$2b$12$Yu.yvxp.oTzopB7vlM3/XeEmeNGBRa0LJHY9HR2HdjrwM2IJfK5ky"
